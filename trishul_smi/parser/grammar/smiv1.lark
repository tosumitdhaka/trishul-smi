// smiv1.lark — SMIv1 grammar (RFC 1155, RFC 1212, RFC 1215)
// Standalone: NOT inherited from smiv2.lark.
//
// bits_type: SMIv2 extension accepted in vendor SMIv1 files (Cisco, NET-SNMP).
//
// QUOTED_STRING: same multiline fix as smiv2.lark (see note there).

// ---------------------------------------------------------------------------
// Top-level
// ---------------------------------------------------------------------------

start : module_definition

module_definition : module_name "DEFINITIONS" "::=" "BEGIN" [exports] [imports] assignment* "END"

module_name : UPPER_ID


// ---------------------------------------------------------------------------
// EXPORTS (RFC 1155 — ignored, present for parse compatibility)
// ---------------------------------------------------------------------------

exports : "EXPORTS" export_list ";"

export_list : export_item ("," export_item)*

export_item : UPPER_ID | LOWER_ID


// ---------------------------------------------------------------------------
// IMPORTS
// ---------------------------------------------------------------------------

imports : "IMPORTS" import_clause+ ";"

import_clause : symbol_list "FROM" module_ref

symbol_list : symbol ("," symbol)*

symbol : UPPER_ID | LOWER_ID

module_ref : UPPER_ID


// ---------------------------------------------------------------------------
// Assignments
// ---------------------------------------------------------------------------

assignment : object_type_assignment
           | trap_type_assignment
           | type_assignment
           | value_assignment
           | macro_assignment

// MACRO body is stripped by the preprocessor in smi_parser.py before parsing.
macro_assignment : UPPER_ID "MACRO" "::=" "BEGIN" "END"


// ---------------------------------------------------------------------------
// OBJECT-TYPE (RFC 1212)
// ---------------------------------------------------------------------------

object_type_assignment : LOWER_ID "OBJECT-TYPE" "SYNTAX" syntax_type "ACCESS" access_value "STATUS" smiv1_status_value [description_clause] [reference_clause] [index_clause] [defval_clause] "::=" oid_value

description_clause : "DESCRIPTION" QUOTED_STRING

index_clause : index_part | augments_part
index_part   : "INDEX" "{" index_list "}"
index_list   : index_item ("," index_item)* [","]
index_item   : ["IMPLIED"] LOWER_ID
augments_part: "AUGMENTS" "{" LOWER_ID "}"

defval_clause : "DEFVAL" "{" defval_value "}"
defval_value  : LOWER_ID | SIGNED_NUMBER | QUOTED_STRING | HEX_STRING | BIN_STRING
              | "{" (bits_value ("," bits_value)*)? "}"
              | "{" NUMBER+ "}"
bits_value    : LOWER_ID


// ---------------------------------------------------------------------------
// TRAP-TYPE (RFC 1215)
// ---------------------------------------------------------------------------

trap_type_assignment : (UPPER_ID | LOWER_ID) "TRAP-TYPE" "ENTERPRISE" LOWER_ID [trap_variables_clause] [description_clause] [reference_clause] "::=" NUMBER

trap_variables_clause : "VARIABLES" "{" object_list "}"
object_list           : LOWER_ID ("," LOWER_ID)*


// ---------------------------------------------------------------------------
// Type / Value assignments
// ---------------------------------------------------------------------------

type_assignment  : UPPER_ID "::=" syntax_type

value_assignment : LOWER_ID "OBJECT" "IDENTIFIER" "::=" oid_value
                 | LOWER_ID UPPER_ID "::=" scalar_value

scalar_value : NUMBER | QUOTED_STRING | LOWER_ID


// ---------------------------------------------------------------------------
// Shared clauses
// ---------------------------------------------------------------------------

reference_clause : "REFERENCE" QUOTED_STRING

!smiv1_status_value : "mandatory" | "optional" | "obsolete" | "deprecated"

!access_value : "read-only" | "read-write" | "write-only" | "not-accessible"


// ---------------------------------------------------------------------------
// Syntax types (RFC 1155 subset)
// ---------------------------------------------------------------------------

syntax_type : builtin_type
            | tagged_type
            | named_type
            | sequence_of_type
            | sequence_type
            | bits_type
            | choice_type

// Tagged ASN.1 types appear in legacy MIBs as application-specific wrappers.
tagged_type : tag [tag_mode] syntax_type
tag         : "[" [tag_class] NUMBER "]"
tag_class   : "UNIVERSAL" | "APPLICATION" | "PRIVATE"
tag_mode    : "IMPLICIT" | "EXPLICIT"

builtin_type : "INTEGER"          [integer_enum | constraint]  -> integer_type
             | "OCTET" "STRING"   [size_constraint]            -> octet_string_type
             | "OBJECT" "IDENTIFIER"                           -> oid_type
             | "NULL"                                          -> null_type
             | "NetworkAddress"                                -> network_address_type
             | "IpAddress"                                     -> ip_address_type
             | "Counter"                                       -> counter_type
             | "Gauge"                                         -> gauge_type
             | "TimeTicks"                                     -> timeticks_type
             | "Opaque"                                        -> opaque_type

named_type      : UPPER_ID [constraint | size_constraint]
sequence_of_type: "SEQUENCE" "OF" UPPER_ID
sequence_type   : "SEQUENCE" "{" sequence_field ("," sequence_field)* "}"
sequence_field  : LOWER_ID syntax_type
               | LOWER_ID "BITS"   -> sequence_field_bits
bits_type       : "BITS" "{" named_bits "}"
named_bits      : named_bit ("," named_bit)* [","]
named_bit       : LOWER_ID "(" NUMBER ")"

// CHOICE body is discarded — used in legacy RFC type definitions only.
choice_type     : "CHOICE" "{" choice_field ("," choice_field)* "}"
choice_field    : LOWER_ID syntax_type

integer_enum : "{" enum_items "}"
enum_items   : enum_item ("," enum_item)*
enum_item    : LOWER_ID "(" SIGNED_NUMBER ")"

constraint       : "(" range_items ")"
range_items      : range_item ("|" range_item)*
range_item       : range_bound ".." range_bound  -> range
                 | range_bound                    -> single_value
range_bound      : SIGNED_NUMBER | HEX_STRING | "MIN" | "MAX"
size_constraint  : "(" "SIZE" "(" range_items ")" ")"


// ---------------------------------------------------------------------------
// OID value
// ---------------------------------------------------------------------------

oid_value : "{" oid_component+ "}"

oid_component : LOWER_ID "(" NUMBER ")"  -> named_arc
              | LOWER_ID                 -> name_arc
              | NUMBER                   -> number_arc


// ---------------------------------------------------------------------------
// Terminals  (same multiline QUOTED_STRING fix as smiv2.lark)
// ---------------------------------------------------------------------------

UPPER_ID      : /[A-Z][A-Za-z0-9\-]*/
LOWER_ID      : /[a-z][A-Za-z0-9\-]*/
NUMBER        : /[0-9]+/
SIGNED_NUMBER : /-?[0-9]+/
HEX_STRING    : /\'[0-9A-Fa-f]*\'[Hh]/
BIN_STRING    : /\'[01]*\'[Bb]/
QUOTED_STRING : /"(?:[^\\"]|\\[\s\S])*"/

WS      : /[ \t\n\r]+/
COMMENT : /--[^\n]*/

%ignore WS
%ignore COMMENT
