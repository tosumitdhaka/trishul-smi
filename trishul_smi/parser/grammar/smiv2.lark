// smiv2.lark — SMIv2 grammar (RFC 2578, RFC 2579, RFC 2580)
// Strategy: LALR(1) for standard MIBs; caller falls back to Earley on parse failure.
// Terminals from common.lark are inlined here for self-containment.

// ---------------------------------------------------------------------------
// Top-level
// ---------------------------------------------------------------------------

start : module_definition

module_definition : module_name "DEFINITIONS" "::=" "BEGIN"
                    imports?
                    assignment*
                    "END"

module_name : UPPER_ID


// ---------------------------------------------------------------------------
// IMPORTS
// ---------------------------------------------------------------------------

imports : "IMPORTS" import_clause+ ";"

import_clause : symbol_list "FROM" module_ref

symbol_list : symbol ("," symbol)*

symbol : UPPER_ID | LOWER_ID

module_ref : UPPER_ID


// ---------------------------------------------------------------------------
// Assignments (top-level MIB declarations)
// ---------------------------------------------------------------------------

assignment : object_type_assignment
           | module_identity_assignment
           | object_identity_assignment
           | notification_type_assignment
           | textual_convention_assignment
           | type_assignment
           | value_assignment
           | object_group_assignment
           | notification_group_assignment
           | module_compliance_assignment
           | agent_capabilities_assignment
           | trap_type_assignment


// ---------------------------------------------------------------------------
// MODULE-IDENTITY (RFC 2578 s4)
// ---------------------------------------------------------------------------

module_identity_assignment : LOWER_ID "MODULE-IDENTITY"
    "LAST-UPDATED" QUOTED_STRING
    "ORGANIZATION" QUOTED_STRING
    "CONTACT-INFO" QUOTED_STRING
    "DESCRIPTION"  QUOTED_STRING
    revision*
    "::=" oid_value

revision : "REVISION" QUOTED_STRING "DESCRIPTION" QUOTED_STRING


// ---------------------------------------------------------------------------
// OBJECT-IDENTITY (RFC 2578 s4)
// ---------------------------------------------------------------------------

object_identity_assignment : LOWER_ID "OBJECT-IDENTITY"
    "STATUS" status_value
    "DESCRIPTION" QUOTED_STRING
    reference_clause?
    "::=" oid_value


// ---------------------------------------------------------------------------
// OBJECT-TYPE (RFC 2578 s7)
// ---------------------------------------------------------------------------

object_type_assignment : LOWER_ID "OBJECT-TYPE"
    "SYNTAX" syntax_type
    units_clause?
    max_access_clause
    "STATUS" status_value
    "DESCRIPTION" QUOTED_STRING
    reference_clause?
    index_clause?
    defval_clause?
    "::=" oid_value

max_access_clause : "MAX-ACCESS" access_value
                  | "ACCESS" access_value

units_clause : "UNITS" QUOTED_STRING

index_clause : index_part | augments_part

index_part : "INDEX" "{" index_list "}"
index_list : index_item ("," index_item)*
index_item : "IMPLIED"? LOWER_ID

augments_part : "AUGMENTS" "{" LOWER_ID "}"

defval_clause : "DEFVAL" "{" defval_value "}"
defval_value  : LOWER_ID | NUMBER | QUOTED_STRING | HEX_STRING | BIN_STRING
              | "{" bits_value* "}"
bits_value    : LOWER_ID


// ---------------------------------------------------------------------------
// NOTIFICATION-TYPE (RFC 2578 s8)
// ---------------------------------------------------------------------------

notification_type_assignment : LOWER_ID "NOTIFICATION-TYPE"
    objects_clause?
    "STATUS" status_value
    "DESCRIPTION" QUOTED_STRING
    reference_clause?
    "::=" oid_value

objects_clause : "OBJECTS" "{" object_list "}"
object_list    : LOWER_ID ("," LOWER_ID)*


// ---------------------------------------------------------------------------
// TEXTUAL-CONVENTION (RFC 2579)
// ---------------------------------------------------------------------------

textual_convention_assignment : UPPER_ID "::=" "TEXTUAL-CONVENTION"
    display_hint_clause?
    "STATUS" status_value
    "DESCRIPTION" QUOTED_STRING
    reference_clause?
    "SYNTAX" syntax_type

display_hint_clause : "DISPLAY-HINT" QUOTED_STRING


// ---------------------------------------------------------------------------
// Plain type assignment  (TypeName ::= SomeType)
// ---------------------------------------------------------------------------

type_assignment : UPPER_ID "::=" syntax_type


// ---------------------------------------------------------------------------
// Value assignment  (name OBJECT IDENTIFIER ::= { ... }  or  name TYPE ::= value)
// ---------------------------------------------------------------------------

value_assignment : LOWER_ID "OBJECT" "IDENTIFIER" "::=" oid_value
                 | LOWER_ID UPPER_ID "::=" scalar_value

scalar_value : NUMBER | QUOTED_STRING | LOWER_ID


// ---------------------------------------------------------------------------
// OBJECT-GROUP / NOTIFICATION-GROUP (RFC 2580)
// ---------------------------------------------------------------------------

object_group_assignment : LOWER_ID "OBJECT-GROUP"
    "OBJECTS" "{" object_list "}"
    "STATUS" status_value
    "DESCRIPTION" QUOTED_STRING
    reference_clause?
    "::=" oid_value

notification_group_assignment : LOWER_ID "NOTIFICATION-GROUP"
    "NOTIFICATIONS" "{" object_list "}"
    "STATUS" status_value
    "DESCRIPTION" QUOTED_STRING
    reference_clause?
    "::=" oid_value


// ---------------------------------------------------------------------------
// MODULE-COMPLIANCE (RFC 2580)
// ---------------------------------------------------------------------------

module_compliance_assignment : LOWER_ID "MODULE-COMPLIANCE"
    "STATUS" status_value
    "DESCRIPTION" QUOTED_STRING
    reference_clause?
    compliance_module*
    "::=" oid_value

compliance_module : "MODULE" module_ref?
    mandatory_groups?
    compliance_item*

mandatory_groups : "MANDATORY-GROUPS" "{" object_list "}"

compliance_item : compliance_group | compliance_object

compliance_group : "GROUP" LOWER_ID "DESCRIPTION" QUOTED_STRING

compliance_object : "OBJECT" LOWER_ID
    syntax_clause?
    write_syntax_clause?
    min_access_clause?
    "DESCRIPTION" QUOTED_STRING

syntax_clause       : "SYNTAX" syntax_type
write_syntax_clause : "WRITE-SYNTAX" syntax_type
min_access_clause   : "MIN-ACCESS" access_value


// ---------------------------------------------------------------------------
// AGENT-CAPABILITIES (RFC 2580)
// ---------------------------------------------------------------------------

agent_capabilities_assignment : LOWER_ID "AGENT-CAPABILITIES"
    "PRODUCT-RELEASE" QUOTED_STRING
    "STATUS"          status_value
    "DESCRIPTION"     QUOTED_STRING
    reference_clause?
    capabilities_module*
    "::=" oid_value

capabilities_module : "SUPPORTS" module_ref
    "INCLUDES" "{" object_list "}"
    variation*

variation : "VARIATION" LOWER_ID
    syntax_clause?
    write_syntax_clause?
    access_clause?
    creation_requires_clause?
    defval_clause?
    "DESCRIPTION" QUOTED_STRING

access_clause            : "ACCESS" access_value
creation_requires_clause : "CREATION-REQUIRES" "{" object_list "}"


// ---------------------------------------------------------------------------
// TRAP-TYPE (SMIv1 compat macro, kept here for mixed-dialect MIBs)
// ---------------------------------------------------------------------------

trap_type_assignment : UPPER_ID "TRAP-TYPE"
    "ENTERPRISE" LOWER_ID
    trap_variables_clause?
    "DESCRIPTION" QUOTED_STRING
    reference_clause?
    "::=" NUMBER

trap_variables_clause : "VARIABLES" "{" object_list "}"


// ---------------------------------------------------------------------------
// Shared clauses
// ---------------------------------------------------------------------------

reference_clause : "REFERENCE" QUOTED_STRING

status_value : "current" | "deprecated" | "obsolete" | "mandatory" | "optional"

access_value : "read-only" | "read-write" | "read-create"
             | "not-accessible" | "accessible-for-notify"
             | "write-only"  // SMIv1 compat


// ---------------------------------------------------------------------------
// Syntax types
// ---------------------------------------------------------------------------

syntax_type : builtin_type
            | named_type
            | sequence_of_type
            | sequence_type
            | bits_type
            | choice_type

builtin_type : "INTEGER"       constraint?                    -> integer_type
             | "OCTET" "STRING" size_constraint?              -> octet_string_type
             | "OBJECT" "IDENTIFIER"                          -> oid_type
             | "NULL"                                         -> null_type
             | "IpAddress"                                    -> ip_address_type
             | "Counter32"                                    -> counter32_type
             | "Counter64"                                    -> counter64_type
             | "Gauge32"                                      -> gauge32_type
             | "Unsigned32"                                   -> unsigned32_type
             | "TimeTicks"                                    -> timeticks_type
             | "Opaque"        size_constraint?               -> opaque_type
             | "Integer32"     constraint?                    -> integer32_type
             | "NetworkAddress"                               -> network_address_type

named_type : UPPER_ID constraint?

sequence_of_type : "SEQUENCE" "OF" UPPER_ID

sequence_type : "SEQUENCE" "{" sequence_field ("," sequence_field)* "}"
sequence_field : LOWER_ID syntax_type

bits_type : "BITS" "{" named_bits "}"
named_bits : named_bit ("," named_bit)*
named_bit  : LOWER_ID "(" NUMBER ")"

choice_type : "CHOICE" "{" choice_field ("," choice_field)* "}"
choice_field : LOWER_ID syntax_type

integer_enum : "{" enum_items "}"
enum_items   : enum_item ("," enum_item)*
enum_item    : LOWER_ID "(" NUMBER ")"

// constraint = value range OR integer enum
constraint : "(" range_items ")"
           | integer_enum

range_items : range_item ("|" range_item)*
range_item  : range_bound ".." range_bound  -> range
            | range_bound                    -> single_value

range_bound : NUMBER | HEX_STRING | "MIN" | "MAX"

size_constraint : "(" "SIZE" "(" range_items ")" ")"


// ---------------------------------------------------------------------------
// OID value  { parent sub-id* }
// ---------------------------------------------------------------------------

oid_value : "{" oid_component+ "}"

oid_component : LOWER_ID "(" NUMBER ")"  -> named_arc
              | LOWER_ID                 -> name_arc
              | NUMBER                   -> number_arc


// ---------------------------------------------------------------------------
// Terminals (self-contained; common.lark values are inlined)
// ---------------------------------------------------------------------------

UPPER_ID      : /[A-Z][A-Za-z0-9\-]*/
LOWER_ID      : /[a-z][A-Za-z0-9\-]*/
NUMBER        : /[0-9]+/
HEX_STRING    : /\'[0-9A-Fa-f]*\'H/
BIN_STRING    : /\'[01]*\'B/
QUOTED_STRING : /"([^"\\]|\\.)*"/

WS      : /[ \t\n\r]+/
COMMENT : /--[^\n]*/

%ignore WS
%ignore COMMENT
