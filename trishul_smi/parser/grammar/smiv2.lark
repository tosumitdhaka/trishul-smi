// smiv2.lark — SMIv2 grammar (RFC 2578, RFC 2579, RFC 2580)
//
// QUOTED_STRING note (issue #3):
//   Real DESCRIPTION fields span multiple lines with literal newlines.
//   The pattern below allows: any char that isn't backslash or quote
//   (which includes \n/\r since character classes are not line-anchored),
//   plus backslash-escape sequences where \[\s\S] covers \" and also
//   backslash-at-end-of-line (\\\n). Both literal \n and escaped \n are
//   handled correctly.
//
// Inline comment note (issue #9):
//   Standard ASN.1 allows inline comments: -- text -- more_code
//   where the comment ends at the closing --. The COMMENT terminal below
//   handles the common -- text EOL form only. The rare closing-double-dash
//   style is not used in practice in IETF/vendor MIBs, so we do not
//   complicate the lexer for it. If needed, change:
//     COMMENT : /--[^\n]*/
//   to:
//     COMMENT : /--(?:[^-]|-(?!-))*(?:--)?/

// ---------------------------------------------------------------------------
// Top-level
// ---------------------------------------------------------------------------

start : module_definition

module_definition : module_name "DEFINITIONS" "::=" "BEGIN" [imports] assignment* "END"

module_name : UPPER_ID


// ---------------------------------------------------------------------------
// IMPORTS
// ---------------------------------------------------------------------------

imports : "IMPORTS" import_clause+ ";"

import_clause : symbol_list "FROM" module_ref

symbol_list : symbol ("," symbol)*

symbol : UPPER_ID | LOWER_ID

module_ref : UPPER_ID


// ---------------------------------------------------------------------------
// Assignments
// ---------------------------------------------------------------------------

assignment : object_type_assignment
           | module_identity_assignment
           | object_identity_assignment
           | notification_type_assignment
           | textual_convention_assignment
           | type_assignment
           | value_assignment
           | object_group_assignment
           | notification_group_assignment
           | module_compliance_assignment
           | agent_capabilities_assignment
           | trap_type_assignment


// ---------------------------------------------------------------------------
// MODULE-IDENTITY
// ---------------------------------------------------------------------------

module_identity_assignment : LOWER_ID "MODULE-IDENTITY" "LAST-UPDATED" QUOTED_STRING "ORGANIZATION" QUOTED_STRING "CONTACT-INFO" QUOTED_STRING "DESCRIPTION" QUOTED_STRING revision* "::=" oid_value

revision : "REVISION" QUOTED_STRING "DESCRIPTION" QUOTED_STRING


// ---------------------------------------------------------------------------
// OBJECT-IDENTITY
// ---------------------------------------------------------------------------

object_identity_assignment : LOWER_ID "OBJECT-IDENTITY" "STATUS" status_value description_clause [reference_clause] "::=" oid_value


// ---------------------------------------------------------------------------
// OBJECT-TYPE
// ---------------------------------------------------------------------------

object_type_assignment : LOWER_ID "OBJECT-TYPE" "SYNTAX" syntax_type [units_clause] max_access_clause "STATUS" status_value description_clause [reference_clause] [index_clause] [defval_clause] "::=" oid_value

max_access_clause : "MAX-ACCESS" access_value
                  | "ACCESS" access_value

units_clause : "UNITS" QUOTED_STRING

index_clause : index_part | augments_part

index_part : "INDEX" "{" index_list "}"
index_list : index_item ("," index_item)*
index_item : ["IMPLIED"] LOWER_ID

augments_part : "AUGMENTS" "{" LOWER_ID "}"

defval_clause : "DEFVAL" "{" defval_value "}"
defval_value  : LOWER_ID | NUMBER | QUOTED_STRING | HEX_STRING | BIN_STRING
              | "{" bits_value* "}"
bits_value    : LOWER_ID


// ---------------------------------------------------------------------------
// NOTIFICATION-TYPE
// ---------------------------------------------------------------------------

notification_type_assignment : LOWER_ID "NOTIFICATION-TYPE" [objects_clause] "STATUS" status_value description_clause [reference_clause] "::=" oid_value

objects_clause : "OBJECTS" "{" object_list "}"
object_list    : LOWER_ID ("," LOWER_ID)*


// ---------------------------------------------------------------------------
// TEXTUAL-CONVENTION
// ---------------------------------------------------------------------------

textual_convention_assignment : UPPER_ID "::=" "TEXTUAL-CONVENTION" [display_hint_clause] "STATUS" status_value description_clause [reference_clause] "SYNTAX" syntax_type

display_hint_clause : "DISPLAY-HINT" QUOTED_STRING


// ---------------------------------------------------------------------------
// Type / Value assignments
// ---------------------------------------------------------------------------

type_assignment  : UPPER_ID "::=" syntax_type

value_assignment : LOWER_ID "OBJECT" "IDENTIFIER" "::=" oid_value
                 | LOWER_ID UPPER_ID "::=" scalar_value

scalar_value : NUMBER | QUOTED_STRING | LOWER_ID


// ---------------------------------------------------------------------------
// OBJECT-GROUP / NOTIFICATION-GROUP
// ---------------------------------------------------------------------------

object_group_assignment : LOWER_ID "OBJECT-GROUP" "OBJECTS" "{" object_list "}" "STATUS" status_value description_clause [reference_clause] "::=" oid_value

notification_group_assignment : LOWER_ID "NOTIFICATION-GROUP" "NOTIFICATIONS" "{" object_list "}" "STATUS" status_value description_clause [reference_clause] "::=" oid_value


// ---------------------------------------------------------------------------
// MODULE-COMPLIANCE
// ---------------------------------------------------------------------------

module_compliance_assignment : LOWER_ID "MODULE-COMPLIANCE" "STATUS" status_value description_clause [reference_clause] compliance_module* "::=" oid_value

compliance_module : "MODULE" [module_ref] [mandatory_groups] compliance_item*

mandatory_groups : "MANDATORY-GROUPS" "{" object_list "}"

compliance_item : compliance_group | compliance_object

compliance_group : "GROUP" LOWER_ID description_clause

compliance_object : "OBJECT" LOWER_ID [syntax_clause] [write_syntax_clause] [min_access_clause] description_clause

syntax_clause       : "SYNTAX" syntax_type
write_syntax_clause : "WRITE-SYNTAX" syntax_type
min_access_clause   : "MIN-ACCESS" access_value


// ---------------------------------------------------------------------------
// AGENT-CAPABILITIES
// ---------------------------------------------------------------------------

agent_capabilities_assignment : LOWER_ID "AGENT-CAPABILITIES" "PRODUCT-RELEASE" QUOTED_STRING "STATUS" status_value description_clause [reference_clause] capabilities_module* "::=" oid_value

capabilities_module : "SUPPORTS" module_ref "INCLUDES" "{" object_list "}" variation*

variation : "VARIATION" LOWER_ID [syntax_clause] [write_syntax_clause] [access_clause] [creation_requires_clause] [defval_clause] description_clause

access_clause            : "ACCESS" access_value
creation_requires_clause : "CREATION-REQUIRES" "{" object_list "}"


// ---------------------------------------------------------------------------
// TRAP-TYPE (SMIv1 compat)
// ---------------------------------------------------------------------------

trap_type_assignment : (UPPER_ID | LOWER_ID) "TRAP-TYPE" "ENTERPRISE" LOWER_ID [trap_variables_clause] [description_clause] [reference_clause] "::=" NUMBER

trap_variables_clause : "VARIABLES" "{" object_list "}"


// ---------------------------------------------------------------------------
// Shared clauses
// ---------------------------------------------------------------------------

description_clause : "DESCRIPTION" QUOTED_STRING

reference_clause : "REFERENCE" QUOTED_STRING

!status_value : "current" | "deprecated" | "obsolete" | "mandatory" | "optional"

!access_value : "read-only" | "read-write" | "read-create"
              | "not-accessible" | "accessible-for-notify"
              | "write-only"


// ---------------------------------------------------------------------------
// Syntax types
// ---------------------------------------------------------------------------

syntax_type : builtin_type
            | named_type
            | sequence_of_type
            | sequence_type
            | bits_type
            | choice_type

builtin_type : "INTEGER"       [constraint]                    -> integer_type
             | "OCTET" "STRING" [size_constraint]              -> octet_string_type
             | "OBJECT" "IDENTIFIER"                           -> oid_type
             | "NULL"                                          -> null_type
             | "IpAddress"                                     -> ip_address_type
             | "Counter32"     [constraint]                    -> counter32_type
             | "Counter64"     [constraint]                    -> counter64_type
             | "Gauge32"       [constraint]                    -> gauge32_type
             | "Unsigned32"    [constraint]                    -> unsigned32_type
             | "TimeTicks"     [constraint]                    -> timeticks_type
             | "Opaque"        [size_constraint]               -> opaque_type
             | "Integer32"     [constraint]                    -> integer32_type
             | "NetworkAddress"                                -> network_address_type

named_type : UPPER_ID [constraint | size_constraint]

sequence_of_type : "SEQUENCE" "OF" UPPER_ID

sequence_type : "SEQUENCE" "{" sequence_field ("," sequence_field)* "}"
sequence_field : LOWER_ID syntax_type

bits_type : "BITS" "{" named_bits "}"
named_bits : named_bit ("," named_bit)*
named_bit  : LOWER_ID "(" NUMBER ")"

choice_type : "CHOICE" "{" choice_field ("," choice_field)* "}"
choice_field : LOWER_ID syntax_type

integer_enum : "{" enum_items "}"
enum_items   : enum_item ("," enum_item)*
enum_item    : LOWER_ID "(" SIGNED_NUMBER ")"

constraint : "(" range_items ")"
           | integer_enum

range_items : range_item ("|" range_item)*
range_item  : range_bound ".." range_bound  -> range
            | range_bound                    -> single_value

range_bound : SIGNED_NUMBER | HEX_STRING | "MIN" | "MAX"

size_constraint : "(" "SIZE" "(" range_items ")" ")"


// ---------------------------------------------------------------------------
// OID value
// ---------------------------------------------------------------------------

oid_value : "{" oid_component+ "}"

oid_component : LOWER_ID "(" NUMBER ")"  -> named_arc
              | LOWER_ID                 -> name_arc
              | NUMBER                   -> number_arc


// ---------------------------------------------------------------------------
// Terminals
// ---------------------------------------------------------------------------

UPPER_ID      : /[A-Z][A-Za-z0-9\-]*/
LOWER_ID      : /[a-z][A-Za-z0-9\-]*/
NUMBER        : /[0-9]+/
SIGNED_NUMBER : /-?[0-9]+/
HEX_STRING    : /\'[0-9A-Fa-f]*\'H/
BIN_STRING    : /\'[01]*\'B/

// QUOTED_STRING: allows literal newlines (common in DESCRIPTION fields) and
// backslash-escape sequences including backslash-newline (\\\n).
// [^\\"]: any char except backslash and quote — character classes
//         include \n/\r so multiline strings work without special flags.
// \\[\s\S]: backslash followed by ANY char incl. newline.
QUOTED_STRING : /"(?:[^\\"]|\\[\s\S])*"/

WS      : /[ \t\n\r]+/
COMMENT : /--[^\n]*/

%ignore WS
%ignore COMMENT
